{"garcon-intro": {"text": "Bonjour, je voudrais", "file": "assets/voix-garcon.m4a", "start": 0, "end": 1.62295, "voice": "Thomas", "pitch": 1}, "garcon-poulet": {"text": "du poulet", "file": "assets/voix-garcon.m4a", "start": 1.92295, "end": 2.52635, "voice": "Thomas", "pitch": 1}, "garcon-steak": {"text": "de la viande", "file": "assets/voix-garcon.m4a", "start": 2.82635, "end": 3.68503, "voice": "Thomas", "pitch": 1}, "garcon-poisson": {"text": "du poisson grillé", "file": "assets/voix-garcon.m4a", "start": 3.98503, "end": 5.11075, "voice": "Thomas", "pitch": 1}, "garcon-pommes-de-terre": {"text": "avec des pommes de terre", "file": "assets/voix-garcon.m4a", "start": 5.41075, "end": 6.70839, "voice": "Thomas", "pitch": 1}, "garcon-pates": {"text": "avec des pâtes", "file": "assets/voix-garcon.m4a", "start": 7.00839, "end": 7.86512, "voice": "Thomas", "pitch": 1}, "garcon-frites": {"text": "avec des frites", "file": "assets/voix-garcon.m4a", "start": 8.16512, "end": 9.07991, "voice": "Thomas", "pitch": 1}, "garcon-salade": {"text": "et de la salade.", "file": "assets/voix-garcon.m4a", "start": 9.37991, "end": 10.34122, "voice": "Thomas", "pitch": 1}, "garcon-tomates": {"text": "et des tomates.", "file": "assets/voix-garcon.m4a", "start": 10.64122, "end": 11.50961, "voice": "Thomas", "pitch": 1}, "garcon-carottes": {"text": "et des carottes.", "file": "assets/voix-garcon.m4a", "start": 11.80961, "end": 12.678, "voice": "Thomas", "pitch": 1}, "garcon-brocoli": {"text": "et du brocoli.", "file": "assets/voix-garcon.m4a", "start": 12.978, "end": 13.84644, "voice": "Thomas", "pitch": 1}, "garcon-yaourt": {"text": "Pour le dessert, je voudrais un yaourt.", "file": "assets/voix-garcon.m4a", "start": 14.14644, "end": 16.61478, "voice": "Thomas", "pitch": 1}, "garcon-glace": {"text": "Pour le dessert, je voudrais une glace à la fraise.", "file": "assets/voix-garcon.m4a", "start": 16.91478, "end": 19.9288, "voice": "Thomas", "pitch": 1}, "garcon-gateau": {"text": "Pour le dessert, je voudrais un morceau de gâteau au chocolat.", "file": "assets/voix-garcon.m4a", "start": 20.2288, "end": 23.67238, "voice": "Thomas", "pitch": 1}, "garcon-kiwi": {"text": "Pour le dessert, je voudrais un kiwi.", "file": "assets/voix-garcon.m4a", "start": 23.97238, "end": 26.27819, "voice": "Thomas", "pitch": 1}, "garcon-pomme": {"text": "Pour le dessert, je voudrais une pomme.", "file": "assets/voix-garcon.m4a", "start": 26.57819, "end": 28.8956, "voice": "Thomas", "pitch": 1}, "garcon-banane": {"text": "Pour le dessert, je voudrais une banane.", "file": "assets/voix-garcon.m4a", "start": 29.1956, "end": 31.66395, "voice": "Thomas", "pitch": 1}, "garcon-orange": {"text": "Pour le dessert, je voudrais une orange.", "file": "assets/voix-garcon.m4a", "start": 31.96395, "end": 34.38585, "voice": "Thomas", "pitch": 1}, "garcon-eau": {"text": "Et pour boire, je voudrais de l’eau.", "file": "assets/voix-garcon.m4a", "start": 34.68585, "end": 36.62236, "voice": "Thomas", "pitch": 1}, "garcon-lait": {"text": "Et pour boire, je voudrais du lait.", "file": "assets/voix-garcon.m4a", "start": 36.92236, "end": 38.87048, "voice": "Thomas", "pitch": 1}, "garcon-jus-orange": {"text": "Et pour boire, je voudrais un jus d’orange.", "file": "assets/voix-garcon.m4a", "start": 39.17048, "end": 41.68748, "voice": "Thomas", "pitch": 1}, "garcon-jus-pomme": {"text": "Et pour boire, je voudrais un jus de pomme.", "file": "assets/voix-garcon.m4a", "start": 41.98748, "end": 44.44644, "voice": "Thomas", "pitch": 1}, "fille-intro": {"text": "Bonjour, je voudrais", "file": "assets/voix-fille.m4a", "start": 0, "end": 1.48213, "voice": "Amélie", "pitch": 1}, "fille-poulet": {"text": "du poulet", "file": "assets/voix-fille.m4a", "start": 1.78213, "end": 2.34499, "voice": "Amélie", "pitch": 1}, "fille-steak": {"text": "de la viande", "file": "assets/voix-fille.m4a", "start": 2.64499, "end": 3.43048, "voice": "Amélie", "pitch": 1}, "fille-poisson": {"text": "du poisson grillé", "file": "asset